CREATE CONSTRAINT actor_id IF NOT EXISTS FOR (a:Actor) REQUIRE a.id IS UNIQUE;
CREATE CONSTRAINT alias_id IF NOT EXISTS FOR (a:Alias) REQUIRE a.id IS UNIQUE;
CREATE CONSTRAINT username_id IF NOT EXISTS FOR (u:Username) REQUIRE u.id IS UNIQUE;
CREATE CONSTRAINT platform_id IF NOT EXISTS FOR (p:Platform) REQUIRE p.id IS UNIQUE;
CREATE CONSTRAINT pgp_id IF NOT EXISTS FOR (p:PGP) REQUIRE p.id IS UNIQUE;
CREATE CONSTRAINT wallet_id IF NOT EXISTS FOR (w:Wallet) REQUIRE w.id IS UNIQUE;
CREATE CONSTRAINT email_id IF NOT EXISTS FOR (e:Email) REQUIRE e.id IS UNIQUE;
CREATE CONSTRAINT post_id IF NOT EXISTS FOR (p:Post) REQUIRE p.id IS UNIQUE;
CREATE CONSTRAINT infra_id IF NOT EXISTS FOR (i:Infrastructure) REQUIRE i.id IS UNIQUE;
CREATE CONSTRAINT onion_id IF NOT EXISTS FOR (o:OnionService) REQUIRE o.id IS UNIQUE;
CREATE CONSTRAINT domain_id IF NOT EXISTS FOR (d:ClearnetDomain) REQUIRE d.id IS UNIQUE;
CREATE CONSTRAINT evidence_id IF NOT EXISTS FOR (e:Evidence) REQUIRE e.id IS UNIQUE;
